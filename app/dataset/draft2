import re
import difflib
import pandas as pd
import numpy as np

from .logger import CleaningLogger

# ------------------------ helpers ------------------------
NULL_EQUIV = {"", "na", "null", "none", "-", "?", "??"}

CANONICAL_DAYS = [
    "monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"
]

CANONICAL_COFFEES = ["espresso", "latte", "cappuccino", "americano"]


def _is_null_like(x: str) -> bool:
    if pd.isna(x):
        return True
    s = str(x).strip().lower()
    return s in NULL_EQUIV


def _clean_alpha_digits(x: str) -> str:
    """Keep letters, digits and single spaces; collapse multiple spaces."""
    if pd.isna(x):
        return ""
    s = str(x)
    # Normalize weird unicode to ascii where possible
    s = s.replace('\u00A0', ' ')
    # remove diacritics by naive mapping for common cases (you can extend)
    s = s.replace('à', 'a').replace('á', 'a').replace('â', 'a')
    s = s.replace('è', 'e').replace('é', 'e')
    s = s.replace('ò', 'o').replace('ó', 'o').replace('ö', 'o')
    # replace common punctuation with nothing
    s = re.sub(r"[^0-9A-Za-z\s\-\.\,]", '', s)
    s = re.sub(r"\s+", ' ', s)
    return s.strip()


# -------------------- semantic normalizers --------------------

def normalize_day_value(val):
    """Normalize many variants of weekday strings into canonical weekday names.
    Returns np.nan for null-like values.
    """
    if _is_null_like(val):
        return np.nan

    s = _clean_alpha_digits(val).lower()
    # remove non letters
    s_letters = re.sub(r"[^a-z]", '', s)
    if not s_letters:
        return np.nan

    # Exact startswith mapping
    for d in CANONICAL_DAYS:
        if s_letters.startswith(d[:3]):
            return d

    # fallback fuzzy match
    m = difflib.get_close_matches(s_letters, CANONICAL_DAYS, n=1, cutoff=0.75)
    return m[0] if m else s_letters


def normalize_coffee_value(val):
    """Normalize coffee types to canonical set (espresso, latte, cappuccino, americano).
    If none matches, return cleaned original or np.nan for nulls.
    """
    if _is_null_like(val):
        return np.nan

    s = _clean_alpha_digits(val).lower()
    # remove internal spaces to better compare e.g. 'espress o' -> 'espresso'
    s_nospace = re.sub(r"\s+", '', s)

    # small heuristics
    s_nospace = s_nospace.replace('0', 'o') if re.search(r'[a-z]0[a-z]|^0', s_nospace) else s_nospace
    s_nospace = s_nospace.replace('expreso', 'espresso').replace('ekspresso', 'espresso')

    # try startswith
    for c in CANONICAL_COFFEES:
        if s_nospace.startswith(c[:4]):
            return c

    # fuzzy
    m = difflib.get_close_matches(s_nospace, CANONICAL_COFFEES, n=1, cutoff=0.75)
    if m:
        return m[0]

    # last fallback: check if contains canonical word
    for c in CANONICAL_COFFEES:
        if c in s_nospace:
            return c

    # else return cleaned string (so caller can inspect)
    return s if s else np.nan


# -------------------- numeric cleaning --------------------

def clean_numeric_value(val):
    """Clean a single value to a numeric literal or NaN.
    Rules:
      - null-like -> NaN
      - remove non-digit except dot and minus
      - remove spaces inside numbers ("3 5" -> 35)
      - convert common letter-O to zero where it looks numeric ("4O" -> 40)
    """
    if _is_null_like(val):
        return np.nan

    s = str(val).strip()
    # Replace common unicode/noise
    s = s.replace('\u2013', '-').replace('\u2014', '-')
    s = s.replace(',', '')

    # collapse internal spaces
    s = re.sub(r"\s+", '', s)

    # replace letter O (capital o) with 0 when it appears next to digits
    s = re.sub(r'(?<=\d)O(?=\d)', '0', s)
    s = re.sub(r'(?<=\d)o(?=\d)', '0', s)

    # strip any trailing/leading non num chars
    s = re.sub(r'^[^0-9\-\.]+', '', s)
    s = re.sub(r'[^0-9\-\.]+$', '', s)

    if s in ['', '-', '.', '+']:
        return np.nan

    # final check: if more than one dot, remove extras (keep first)
    if s.count('.') > 1:
        parts = s.split('.')
        s = parts[0] + '.' + ''.join(parts[1:])

    try:
        # prefer int when possible
        if '.' in s:
            v = float(s)
            # if float is an integer value, cast to int
            if v.is_integer():
                return int(v)
            return v
        else:
            return int(s)
    except Exception:
        return np.nan


# -------------------- pipeline steps --------------------

def clean_column_name(df, log):
    original_cols = df.columns.tolist()
    df = df.copy()
    df.columns = (
        df.columns.str.strip()
        .str.lower()
        .str.replace(' ', '_')
        .str.replace(r'[^a-zA-Z0-9_]', '', regex=True)
    )
    log.add('clean_column_name', {'before': original_cols, 'after': df.columns.tolist()})
    return df


def drop_entry_duplicate(df, log):
    before = len(df)
    df = df.dropna(how='all')
    after_dropna = len(df)
    df = df.drop_duplicates(keep='first')
    after_dedup = len(df)
    log.add('drop_entry_duplicate', {
        'dropped_nan': before - after_dropna,
        'dropped_duplicates': after_dropna - after_dedup,
        'total_after_cleaning': after_dedup
    })
    return df


def trim_text_columns(df, log):
    trim_counts = {}
    for col in df.select_dtypes(include=['object']).columns:
        original = df[col].astype(object).where(~df[col].isna(), '')
        trimmed = original.map(lambda x: str(x).strip())
        changed_count = (original != trimmed).sum()
        if changed_count > 0:
            trim_counts[col] = int(changed_count)
        df[col] = trimmed.replace({'': np.nan})
    log.add('trim_column_values', {'affected_columns': trim_counts})
    return df


def normalize_semantic_columns(df, log):
    """Apply semantic normalizers for 'day' and 'coffee_type' columns if present."""
    counts = {'day': 0, 'coffee_type': 0}

    if 'day' in df.columns:
        df['day_original_for_log'] = df['day'].copy()
        df['day'] = df['day'].map(normalize_day_value)
        counts['day'] = int((df['day_original_for_log'].astype(str) != df['day'].astype(str)).sum())
        df = df.drop(columns=['day_original_for_log'])

    if 'coffee_type' in df.columns:
        df['coffee_original_for_log'] = df['coffee_type'].copy()
        df['coffee_type'] = df['coffee_type'].map(normalize_coffee_value)
        counts['coffee_type'] = int((df['coffee_original_for_log'].astype(str) != df['coffee_type'].astype(str)).sum())
        df = df.drop(columns=['coffee_original_for_log'])

    log.add('normalize_semantic', {'affected': counts})
    return df


def convert_numeric(df, log, required_ratio=0.5):
    """Attempt to convert object columns to numeric after cleaning values.
    If a column after cleaning has at least `required_ratio` non-null numerics, we assign numeric dtype.
    """
    numeric_log = {}
    for col in df.select_dtypes(include=['object']).columns:
        series = df[col]
        # try cleaning values
        cleaned = series.map(clean_numeric_value)
        success_rate = cleaned.notna().mean()
        if success_rate >= required_ratio:
            converted = pd.to_numeric(cleaned, errors='coerce')
            df[col] = converted
            numeric_log[col] = int(converted.notna().sum())
    log.add('convert_numeric', {'affected_columns': numeric_log})
    return df


def convert_date(df, log, required_ratio=0.6):
    date_log = {}
    for col in df.select_dtypes(include=['object']).columns:
        col_series = df[col].astype(str)
        # try parsing
        parsed = pd.to_datetime(col_series, errors='coerce', infer_datetime_format=True, dayfirst=False)
        success_rate = parsed.notna().mean()
        if success_rate >= required_ratio:
            df[col] = parsed.dt.strftime('%Y-%m-%d')
            date_log[col] = int(parsed.notna().sum())
    log.add('convert_date', {'affected_columns': date_log})
    return df


def fill_missing(df, log):
    numeric_log = {}
    category_log = {}

    for col in df.columns:
        missing_before = df[col].isna().sum()
        if missing_before == 0:
            continue

        if pd.api.types.is_numeric_dtype(df[col]):
            median = df[col].median()
            df[col] = df[col].fillna(median)
            numeric_log[col] = int(missing_before)
        else:
            mode = df[col].mode()
            fill_value = mode[0] if not mode.empty else 'Unknown'
            df[col] = df[col].fillna(fill_value)
            category_log[col] = int(missing_before)

    log.add('fill_missing', {'numeric': numeric_log, 'categorical': category_log})
    return df


def dedupe_after_normalize(df, log):
    before = len(df)
    df = df.drop_duplicates(keep='first')
    after = len(df)
    log.add('dedupe_after_normalize', {'dropped_duplicates': before - after, 'total_after': after})
    return df


# -------------------- orchestrator --------------------

def clean_data(df_raw):
    """Full robust cleaning pipeline.
    Returns: cleaned_df, log_dict
    Usage: cleaned_df, log = clean_data(df)
    """
    log = CleaningLogger()
    df = df_raw.copy()

    # 1. standardize column names
    df = clean_column_name(df, log)

    # 2. drop fully empty rows and trivial duplicates early
    df = drop_entry_duplicate(df, log)

    # 3. trim whitespaces and normalize empty strings to NaN
    df = trim_text_columns(df, log)

    # 4. semantic normalizers (day, coffee_type) BEFORE numeric/date conversion
    df = normalize_semantic_columns(df, log)

    # 5. convert numeric-like columns (use cleaned numeric rules)
    df = convert_numeric(df, log, required_ratio=0.4)

    # 6. convert date-like columns (if any)
    df = convert_date(df, log, required_ratio=0.6)

    # 7. fill missing values using median/mode
    df = fill_missing(df, log)

    # 8. final dedupe
    df = dedupe_after_normalize(df, log)

    return df, log.get_log()
